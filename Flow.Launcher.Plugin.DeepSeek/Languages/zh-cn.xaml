<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="plugin_deepseek_plugin_name">DeepSeek</system:String>
    <system:String x:Key="plugin_deepseek_plugin_description">在浏览器中直接向 DeepSeek 提问</system:String>

    <system:String x:Key="plugin_deepseek_empty_title">向 DeepSeek 提问</system:String>
    <system:String x:Key="plugin_deepseek_empty_subtitle">在关键词后面输入你的问题，回车直达</system:String>
    <system:String x:Key="plugin_deepseek_open_subtitle">打开 DeepSeek 网页版并提问</system:String>
    <system:String x:Key="plugin_deepseek_too_long">提示词过长无法拼进网址，已复制到剪贴板，粘贴后发送即可</system:String>
    <system:String x:Key="plugin_deepseek_deepthink_title">用深度思考（R1）提问</system:String>
    <system:String x:Key="plugin_deepseek_copy_title">复制这条提示词到剪贴板</system:String>

    <system:String x:Key="plugin_deepseek_menu_open_plain">打开：不开深度思考、不联网</system:String>
    <system:String x:Key="plugin_deepseek_menu_open_search">打开：开启联网搜索</system:String>
    <system:String x:Key="plugin_deepseek_menu_open_deepthink">打开：开启深度思考（R1）</system:String>
    <system:String x:Key="plugin_deepseek_menu_copy_link">复制 DeepSeek 链接</system:String>

    <system:String x:Key="plugin_deepseek_flag_deepthink">深度思考</system:String>
    <system:String x:Key="plugin_deepseek_flag_search">联网</system:String>
    <system:String x:Key="plugin_deepseek_flag_autosend">自动发送</system:String>

    <system:String x:Key="plugin_deepseek_setting_autosend">打开后自动发送提示词</system:String>
    <system:String x:Key="plugin_deepseek_setting_deepthink">默认开启深度思考（R1）</system:String>
    <system:String x:Key="plugin_deepseek_setting_search">默认开启联网搜索</system:String>
    <system:String x:Key="plugin_deepseek_setting_show_copy">结果里始终显示"复制提示词"</system:String>
    <system:String x:Key="plugin_deepseek_setting_prefix">提示词前缀（可留空）</system:String>
    <system:String x:Key="plugin_deepseek_setting_prefix_hint">会加在每条提问的最前面，例如"请用中文简洁回答"。</system:String>
</ResourceDictionary>
