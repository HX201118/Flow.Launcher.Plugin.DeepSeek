<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <system:String x:Key="plugin_deepseek_plugin_name">DeepSeek</system:String>
    <system:String x:Key="plugin_deepseek_plugin_description">Ask DeepSeek in your browser</system:String>

    <system:String x:Key="plugin_deepseek_empty_title">Ask DeepSeek</system:String>
    <system:String x:Key="plugin_deepseek_empty_subtitle">Type your question after the action keyword</system:String>
    <system:String x:Key="plugin_deepseek_open_subtitle">Open DeepSeek in the browser and ask</system:String>
    <system:String x:Key="plugin_deepseek_too_long">Prompt is too long for a URL, it has been copied to the clipboard</system:String>
    <system:String x:Key="plugin_deepseek_deepthink_title">Ask with DeepThink (R1)</system:String>
    <system:String x:Key="plugin_deepseek_copy_title">Copy this prompt to the clipboard</system:String>

    <system:String x:Key="plugin_deepseek_menu_open_plain">Open without DeepThink / web search</system:String>
    <system:String x:Key="plugin_deepseek_menu_open_search">Open with web search</system:String>
    <system:String x:Key="plugin_deepseek_menu_open_deepthink">Open with DeepThink (R1)</system:String>
    <system:String x:Key="plugin_deepseek_menu_copy_link">Copy the DeepSeek link</system:String>

    <system:String x:Key="plugin_deepseek_flag_deepthink">DeepThink</system:String>
    <system:String x:Key="plugin_deepseek_flag_search">Search</system:String>
    <system:String x:Key="plugin_deepseek_flag_autosend">Auto send</system:String>

    <system:String x:Key="plugin_deepseek_setting_autosend">Send the prompt automatically</system:String>
    <system:String x:Key="plugin_deepseek_setting_deepthink">DeepThink (R1) by default</system:String>
    <system:String x:Key="plugin_deepseek_setting_search">Web search by default</system:String>
    <system:String x:Key="plugin_deepseek_setting_show_copy">Always show the "copy prompt" result</system:String>
    <system:String x:Key="plugin_deepseek_setting_prefix">Prompt prefix (optional)</system:String>
    <system:String x:Key="plugin_deepseek_setting_prefix_hint">Prepended to every prompt, e.g. "Answer in Chinese, be concise".</system:String>
</ResourceDictionary>
